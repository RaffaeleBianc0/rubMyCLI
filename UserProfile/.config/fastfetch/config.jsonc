// ~/.config/fastfetch/config.jsonc
// See https://github.com/fastfetch-cli/fastfetch/wiki/Configuration for more details
// See *.jsonc in https://github.com/fastfetch-cli/fastfetch/tree/dev/presets/examples for more examples
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 0
        },
        //"source": "C:/Users/utente/AppData/Roaming/WindowsTerminal/LogoPS.chafa",
        "printRemaining": true
    },
    "modules": [
        {
            "type": "host",
            "key": "  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "chassis",
            "key": "󰠱  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "cpu",
            "key": "󰘚  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "gpu",
            "key": "󰊴  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "memory",
            "key": "󰑭  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "swap",
            "key": "󰯍  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "disk",
            "keyColor": "yellow",
            "keyWidth": 0,
            "key": "{1}",
            "showExternal": true,
            "showHidden": false,
            "showSubvolumes": false,
            "showUnknown": false
        },
        {
            "type": "battery",
            "key": "  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "monitor",
            "key": "󰍹  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "brightness",
            "key": "󰃞  ",
            "keyColor": "yellow",
            "keyWidth": 0
        },
        {
            "type": "break"
        },
        {
            "type": "bluetooth",
            "key": " ",
            "keyColor": "bright_red",
            "keyWidth": 0,
            "showDisconnected": false
        },
        {
            "type": "wifi",
            "key": " ",
            "keyColor": "bright_red",
            "keyWidth": 0
        },
        {
            "type": "localip",
            "key": "󰩟 ",
            "keyColor": "bright_red",
            "keyWidth": 0,
            "compact": true,
            "defaultRouteOnly": true
        },
        {
            "type": "publicip",
            "key": "󰩠 ",
            "keyColor": "bright_red",
            "keyWidth": 0,
            "timeout": 500
        },
        {
            "type": "break"
        },
        {
            "type": "title",
            "key": " ",
            "format": "{1} @ {2}",
            "keyColor": "blue",
            "color": {
                "host": "blue",
                "user": "blue",
                "at": "white"
            }
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "terminalsize",
            "key": " ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "blue",
            "keyWidth": 0
        },
        {
            "type": "break"
        },
        {
            "type": "datetime",
            "key": "󰃰 ",
            "keyColor": "green",
            "keyWidth": 0
        },
        {
            "type": "weather",
            "outputFormat": "%l:+%c+🌡️%t+🌬️%w+🏖️%u+☂️%p",
            "timeout": 500,
            "key": "󰖕 ",
            "keyColor": "green",
            "keyWidth": 0
        },
        {
            "type": "break"
        },
        {
            "type": "colors"
        },
        {
            "type": "break"
        }
    ],
    "display": {
        "percent": {
            "type": 3
        },
        "bar": {
            "border": null
        },
        "separator": " ",
        "size": {
            "maxPrefix": "TB",
            "ndigits": 0
        }
    },
    "library": {
    }
}
